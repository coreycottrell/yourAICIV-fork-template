            },
            {
                "type": "features",
                "heading": "What We Offer",
                "items": [
                    {"title": "Feature 1", "description": "Describe feature one."},
                    {"title": "Feature 2", "description": "Describe feature two."},
                    {"title": "Feature 3", "description": "Describe feature three."}
                ]
            },
            {
                "type": "cta",
                "heading": "Ready to get started?",
                "content": "Reach out today.",
                "cta_text": "Contact Us",
                "cta_url": "/contact"
            }
        ],
        "nav_links": [],
        "footer": {
            "text": "",
            "links": []
        }
    },

    "payment": {
        "_note": "Stripe is the default/recommended processor. Alternatives available if needed.",
        "active_provider": "stripe",
        "providers": {
            "stripe": {"enabled": true, "label": "Credit / Debit Card (Stripe)"},
            "manual": {"enabled": true, "label": "Pay Later / Invoice"},
            "ach_direct": {"enabled": false, "label": "ACH Bank Transfer"},
            "barterpay": {"enabled": false, "label": "BarterPay"},
            "clickbrick": {"enabled": false, "label": "ClickBrick ACH"},
            "crypto": {"enabled": false, "label": "Cryptocurrency"}
        }
    },

    "env_vars_needed": [
        "CLIENT_ADMIN_USER",
        "CLIENT_ADMIN_PASS",
        "CLIENT_SECRET_KEY",
        "STRIPE_SECRET_KEY    (Stripe API secret key -- default payment)",
        "STRIPE_WEBHOOK_SECRET (Stripe webhook signing secret)",
        "RESEND_API_KEY       (if email_marketing enabled)",
        "EMAIL_FROM           (if email_marketing enabled)",
        "TELEGRAM_BOT_TOKEN   (optional notifications)",
        "TELEGRAM_CHAT_ID     (optional notifications)",
        "CLIENT_CRON_KEY      (optional API protection)",
        "ACH_API_KEY          (if ach_direct payment)",
        "BARTERPAY_API_KEY    (if barterpay payment)",
        "CLICKBRICK_API_KEY   (if clickbrick payment)"
    ]
}

        },
        "hero": {
            "heading": "Welcome to Acme Business",
            "subheading": "Your tagline here",
            "cta_text": "Get Started",
            "cta_url": "/contact",
            "background_image": ""
        },
        "sections": [
            {
                "type": "text",
